msgctxt "StorageFilterIcons.STRINGS.OPTIONS.OPACITY.NAME"
msgid "Icon opacity"
msgstr "アイコンの不透明度"

msgctxt "StorageFilterIcons.STRINGS.OPTIONS.OPACITY.TOOLTIP"
msgid "Opacity of the overlay icons (when not hovered, or when hover opacity is Translucent)."
msgstr "オーバーレイアイコンの不透明度(ホバーしていないとき、またはホバー時の不透明度が「半透明」のとき)"

msgctxt "StorageFilterIcons.STRINGS.OPTIONS.HOVER_SCALE.NAME"
msgid "Icons on hover: size"
msgstr "ホバー時のアイコン: サイズ"

msgctxt "StorageFilterIcons.STRINGS.OPTIONS.HOVER_SCALE.TOOLTIP"
msgid "What happens to the overlay icons while the cursor is over the building."
msgstr "カーソルが建物に重なっているときのアイコンの挙動"

msgctxt "StorageFilterIcons.STRINGS.OPTIONS.HOVER_SCALE.ENLARGE"
msgid "Enlarge"
msgstr "拡大する"

msgctxt "StorageFilterIcons.STRINGS.OPTIONS.HOVER_SCALE.ENLARGE_TOOLTIP"
msgid "Enlarge the icons."
msgstr "アイコンを拡大表示します"

msgctxt "StorageFilterIcons.STRINGS.OPTIONS.HOVER_SCALE.NORMAL"
msgid "Unchanged"
msgstr "そのまま"

msgctxt "StorageFilterIcons.STRINGS.OPTIONS.HOVER_SCALE.NORMAL_TOOLTIP"
msgid "Keep the icons at their normal size."
msgstr "アイコンの大きさを変えません"

msgctxt "StorageFilterIcons.STRINGS.OPTIONS.HOVER_SCALE.HIDE"
msgid "Hide"
msgstr "消す"

msgctxt "StorageFilterIcons.STRINGS.OPTIONS.HOVER_SCALE.HIDE_TOOLTIP"
msgid "Hide the icons."
msgstr "アイコンを非表示にします"

msgctxt "StorageFilterIcons.STRINGS.OPTIONS.HOVER_OPACITY.NAME"
msgid "Icons on hover: opacity"
msgstr "ホバー時のアイコン: 不透明度"

msgctxt "StorageFilterIcons.STRINGS.OPTIONS.HOVER_OPACITY.TOOLTIP"
msgid "Opacity of the overlay icons while the cursor is over the building. Ignored when the size option is Hide."
msgstr "カーソルが建物に重なっているときのアイコンの不透明度(サイズが「消す」のときは無効)"

msgctxt "StorageFilterIcons.STRINGS.OPTIONS.HOVER_OPACITY.TRANSLUCENT"
msgid "Translucent"
msgstr "半透明のまま"

msgctxt "StorageFilterIcons.STRINGS.OPTIONS.HOVER_OPACITY.TRANSLUCENT_TOOLTIP"
msgid "Keep the icons translucent."
msgstr "アイコンを半透明のままにします"

msgctxt "StorageFilterIcons.STRINGS.OPTIONS.HOVER_OPACITY.OPAQUE"
msgid "Opaque"
msgstr "不透過表示"

msgctxt "StorageFilterIcons.STRINGS.OPTIONS.HOVER_OPACITY.OPAQUE_TOOLTIP"
msgid "Draw the icons fully opaque."
msgstr "アイコンを不透明で表示します"

msgctxt "StorageFilterIcons.STRINGS.OPTIONS.SHOW_IN_HOVER_CARD.NAME"
msgid "Show icons in hover card"
msgstr "ホバーカードにアイコンを表示"

msgctxt "StorageFilterIcons.STRINGS.OPTIONS.SHOW_IN_HOVER_CARD.TOOLTIP"
msgid "Also list the filtered resource icons in the card shown when hovering a building."
msgstr "建物にカーソルを合わせたときのカードにも、フィルタ設定されている資源のアイコンを表示します"

msgctxt "StorageFilterIcons.STRINGS.OPTIONS.DISABLED_BUILDINGS.NAME"
msgid "Buildings"
msgstr "対象の建物"

msgctxt "StorageFilterIcons.STRINGS.OPTIONS.DISABLED_BUILDINGS.TOOLTIP"
msgid "Choose the buildings that show filter icons."
msgstr "フィルタアイコンを表示する建物を選択します"
